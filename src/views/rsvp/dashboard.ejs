<section class="mb-6 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-blue-600 to-blue-700 shadow-lg">
  <h1 class="text-2xl sm:text-3xl font-bold text-white mb-1">My RSVPs</h1>
  <p class="text-blue-200 text-sm sm:text-base m-0">
    Events you have responded to, grouped into upcoming and past.
  </p>
  <div class="flex gap-4 mt-4">
    <div class="inline-flex items-center gap-2 rounded-lg bg-white/15 px-3 py-1.5 text-sm text-white">
      <span class="w-2 h-2 rounded-full bg-green-400"></span>
      <span><strong><%= upcoming.length %></strong> upcoming</span>
    </div>
    <div class="inline-flex items-center gap-2 rounded-lg bg-white/15 px-3 py-1.5 text-sm text-white">
      <span class="w-2 h-2 rounded-full bg-slate-400"></span>
      <span><strong><%= past.length %></strong> past</span>
    </div>
  </div>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<div id="my-rsvps-content">
  <%- include("partials/dashboard-content", { upcoming: upcoming, past: past }) %>
</div>
