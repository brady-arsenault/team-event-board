<div
  id="rsvp-widget"
  x-data="{ show: false }"
  x-init="$nextTick(() => show = true)"
>
  <% const isGoing = rsvp && rsvp.status === "going"; %>
  <% const isWaitlisted = rsvp && rsvp.status === "waitlisted"; %>
  <% const isActive = isGoing || isWaitlisted; %>

  <div
    class="inline-flex items-center gap-2"
    x-show="show"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0 -translate-y-1 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
  >
    <% if (isGoing) { %>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-emerald-800 border border-emerald-300 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
        Going
      </span>
    <% } else if (isWaitlisted) { %>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-amber-800 border border-amber-300 shadow-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-500" aria-hidden="true"></span>
        Waitlisted
      </span>
    <% } %>

    <form
      method="post"
      action="/events/<%= eventId %>/rsvp"
      hx-post="/events/<%= eventId %>/rsvp"
      hx-target="#rsvp-widget"
      hx-swap="outerHTML"
      class="m-0"
    >
      <% if (isActive) { %>
        <button
          type="submit"
          class="inline-flex items-center px-4 py-2 rounded-2xl border border-rose-300 bg-white text-rose-700 text-sm font-semibold shadow-sm hover:bg-rose-50 hover:border-rose-400 active:scale-95 transition-all duration-200 cursor-pointer"
        >
          Cancel RSVP
        </button>
      <% } else { %>
        <button
          type="submit"
          class="inline-flex items-center px-5 py-2 rounded-2xl bg-gradient-to-b from-green-500 to-green-600 text-white text-sm font-semibold shadow-md hover:from-green-600 hover:to-green-700 hover:shadow-lg active:scale-95 transition-all duration-200 cursor-pointer ring-1 ring-green-700/30"
        >
          RSVP
        </button>
      <% } %>
    </form>
  </div>
</div>
