<section class="mb-6">
  <div class="flex items-center gap-2 mb-4">
    <span class="w-2 h-2 rounded-full bg-green-500"></span>
    <h2 class="text-lg sm:text-xl font-semibold text-slate-900">Upcoming</h2>
  </div>

  <% if (upcoming.length === 0) { %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-8 sm:p-10 text-center">
      <svg class="mx-auto h-10 w-10 text-slate-300 mb-3" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      <p class="text-slate-500 text-sm m-0">
        You have no upcoming RSVPs.
      </p>
      <a href="/events/search" class="inline-flex items-center mt-3 text-sm font-medium text-blue-600 no-underline hover:text-blue-800 transition-colors">
        Browse events &rarr;
      </a>
    </div>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% upcoming.forEach(function (item) { %>
        <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-blue-200 transition-all duration-200">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <a
                href="/events/<%= item.event.id %>/detail"
                class="text-base sm:text-lg font-semibold text-slate-900 no-underline hover:text-blue-700 transition-colors line-clamp-1"
              >
                <%= item.event.title %>
              </a>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1.5 text-xs sm:text-sm text-slate-500">
                <span class="inline-flex items-center gap-1">
                  <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  <%= item.event.startAt.toLocaleString() %>
                </span>
                <span class="hidden sm:inline text-slate-300">&middot;</span>
                <span class="inline-flex items-center gap-1">
                  <svg class="h-3.5 w-3.5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  <%= item.event.location %>
                </span>
              </div>
            </div>
            <% if (item.rsvp.status === "going") { %>
              <span class="shrink-0 inline-flex items-center rounded-full bg-green-50 px-2.5 py-1 text-xs font-semibold text-green-700 border border-green-200">
                Going
              </span>
            <% } else if (item.rsvp.status === "waitlisted") { %>
              <span class="shrink-0 inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 border border-amber-200">
                Waitlisted
              </span>
            <% } %>
          </div>
          <div class="flex items-center justify-between mt-4 pt-3 border-t border-slate-100">
            <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 capitalize">
              <%= item.event.category %>
            </span>
            <form
              method="post"
              action="/events/<%= item.event.id %>/rsvp"
              hx-post="/events/<%= item.event.id %>/rsvp"
              hx-target="#my-rsvps-content"
              hx-swap="innerHTML"
              hx-headers='{"HX-Trigger-Name": "rsvp-dashboard"}'
              class="m-0"
            >
              <button
                type="submit"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-red-600 border border-red-200 bg-white cursor-pointer hover:bg-red-50 hover:border-red-300 focus:outline-none focus:ring-2 focus:ring-red-500/20 transition-colors"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                Cancel RSVP
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
