<section class="mb-6">
  <div class="flex items-center gap-2 mb-4">
    <span class="w-2 h-2 rounded-full bg-slate-400"></span>
    <h2 class="text-lg sm:text-xl font-semibold text-slate-900">Past &amp; Cancelled</h2>
  </div>

  <% if (past.length === 0) { %>
    <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-white p-8 text-center">
      <p class="text-slate-400 text-sm m-0">
        No past or cancelled RSVPs yet.
      </p>
    </div>
  <% } else { %>
    <div class="grid gap-3 sm:grid-cols-2">
      <% past.forEach(function (item) { %>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 opacity-70 hover:opacity-100 transition-opacity duration-200">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <h3 class="text-base font-semibold text-slate-600 line-clamp-1 mb-1">
                <%= item.event.title %>
              </h3>
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-400">
                <span class="inline-flex items-center gap-1">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
                  </svg>
                  <%= item.event.startAt.toLocaleString() %>
                </span>
                <span class="hidden sm:inline text-slate-300">&middot;</span>
                <span class="inline-flex items-center gap-1">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  <%= item.event.location %>
                </span>
              </div>
            </div>
            <% const badgeStatus = item.rsvp.status === "cancelled" ? "cancelled" : item.event.status; %>
            <% if (badgeStatus === "cancelled") { %>
              <span class="shrink-0 inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-600 border border-red-200 capitalize">
                <%= badgeStatus %>
              </span>
            <% } else { %>
              <span class="shrink-0 inline-flex items-center rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-500 border border-slate-200 capitalize">
                <%= badgeStatus %>
              </span>
            <% } %>
          </div>
          <div class="mt-3 pt-2 border-t border-slate-100">
            <span class="inline-flex items-center rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500 capitalize">
              <%= item.event.category %>
            </span>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
