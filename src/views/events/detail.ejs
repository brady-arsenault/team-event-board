  <%              
    const currentUser = session.authenticatedUser;                                                          
    const isOrganizer = currentUser && currentUser.userId === event.organizerId;
    const isAdmin = currentUser && currentUser.role === "admin";                                            
    const startIso = event.startAt.toISOString();
    const endIso = event.endAt.toISOString();                                                               
                                                                                                            
    let statusBadgeClasses = "bg-slate-100 text-slate-700 border-slate-200";                                
    if (event.status === "draft") {                                                                         
      statusBadgeClasses = "bg-amber-100 text-amber-800 border-amber-200";                                  
    } else if (event.status === "published") {                                                              
      statusBadgeClasses = "bg-emerald-100 text-emerald-800 border-emerald-200";
    } else if (event.status === "cancelled") {                                                              
      statusBadgeClasses = "bg-rose-100 text-rose-800 border-rose-200";                                     
    }
  %>                                                                                                        
  <section        
    id="event-detail"
    class="max-w-3xl mx-auto bg-white border border-slate-200 rounded-3xl shadow-lg overflow-hidden"        
    x-data="{                                                                                               
      badgePulse: false,                                                                                    
      relativeLabel(isoStr) {                                                                               
        if (typeof Intl === 'undefined' || typeof Intl.RelativeTimeFormat !== 'function') return '';        
        const target = new Date(isoStr).getTime();                                                          
        if (Number.isNaN(target)) return '';                                                                
        const diffMs = target - Date.now();                                                                 
        const abs = Math.abs(diffMs);                                                                       
        const minute = 60000, hour = 60 * minute, day = 24 * hour;                                          
        const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });                            
        if (abs < hour) return rtf.format(Math.round(diffMs / minute), 'minute');                           
        if (abs < day) return rtf.format(Math.round(diffMs / hour), 'hour');                                
        if (abs < 30 * day) return rtf.format(Math.round(diffMs / day), 'day');                             
        if (abs < 365 * day) return rtf.format(Math.round(diffMs / (30 * day)), 'month');                   
        return rtf.format(Math.round(diffMs / (365 * day)), 'year');                                        
      }                                                                                                     
    }"                                                                                                      
    x-init="badgePulse = true; setTimeout(() => badgePulse = false, 500)"
  >                                                                                                         
    <header class="px-6 pt-6 pb-5 border-b border-slate-200 bg-gradient-to-b from-slate-50 to-white">
      <div class="flex items-start justify-between gap-4">                                                  
        <div class="min-w-0">                                                                               
          <p class="text-xs font-semibold uppercase tracking-wide text-blue-600 mb-1">                      
            <%= event.category %>                                                                           
          </p>    
          <h1 class="text-3xl font-bold text-slate-900 leading-tight break-words">                          
            <%= event.title %>                                                                              
          </h1>
          <p class="text-sm text-slate-500 mt-2 flex items-center gap-1.5">                                 
            <span aria-hidden="true">📍</span>                                                              
            <span><%= event.location %></span>
          </p>                                                                                              
        </div>    
        <span                                                                                               
          class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold uppercase
  tracking-wide border shrink-0 transform transition duration-300 ease-out <%= statusBadgeClasses %>"       
          x-bind:class="badgePulse ? 'scale-110 shadow-md' : 'scale-100'"
        >                                                                                                   
          <%= event.status %>
        </span>                                                                                             
      </div>      
    </header>

  <div class="px-6 py-6 space-y-6">
    <% if (pageError) { %>
      <%- include("../partials/error", { message: pageError }) %>
    <% } %>

    <section aria-labelledby="event-description-heading">
      <h2 id="event-description-heading" class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">
        Description
      </h2>
      <p class="text-slate-700 leading-relaxed whitespace-pre-line"><%= event.description %></p>
    </section>

    <section aria-labelledby="event-when-heading">
      <h2 id="event-when-heading" class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">
        When
      </h2>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="text-xs font-medium text-slate-500 mb-1">Starts</p>
          <p class="text-sm font-semibold text-slate-900"><%= event.startAt.toLocaleString() %></p>
          <p
            class="text-xs text-blue-700 mt-1"
            x-text="relativeLabel('<%= startIso %>')"
            x-cloak
          ></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="text-xs font-medium text-slate-500 mb-1">Ends</p>
          <p class="text-sm font-semibold text-slate-900"><%= event.endAt.toLocaleString() %></p>
          <p
            class="text-xs text-blue-700 mt-1"
            x-text="relativeLabel('<%= endIso %>')"
            x-cloak
          ></p>
        </div>
      </div>
    </section>

    <section aria-labelledby="event-meta-heading">
      <h2 id="event-meta-heading" class="text-xs font-semibold uppercase tracking-wide text-slate-500 mb-2">
        Details
      </h2>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="text-xs font-medium text-slate-500 mb-1">Organizer</p>
          <p class="text-sm font-semibold text-slate-900 break-words"><%= event.organizerId %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="text-xs font-medium text-slate-500 mb-1">Capacity</p>
          <p class="text-sm font-semibold text-slate-900">
            <% if (event.capacity !== null) { %>
              <%= event.capacity %> spots
            <% } else { %>
              Unlimited
            <% } %>
          </p>
        </div>
      </div>
    </section>
  </div>

  <footer class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between gap-3 flex-wrap">
    <a
      href="/home"
      class="inline-flex items-center px-4 py-2 rounded-2xl border border-slate-200 bg-white text-slate-700 text-sm font-medium hover:bg-slate-100"
    >
      &larr; Back to Events
    </a>

    <div class="flex items-center gap-3 flex-wrap">
      <div id="rsvp-widget"
        hx-get="/events/<%= event.id %>/rsvp"
        hx-trigger="load"
        hx-swap="outerHTML"
      ></div>

      <% if (isOrganizer && event.status === "draft") { %>
        <form
          action="/events/<%= event.id %>/publish"
          method="post"
          hx-post="/events/<%= event.id %>/publish"
          hx-target="#event-detail"
          hx-swap="outerHTML"
        >
          <button
            type="submit"
            class="inline-flex items-center px-4 py-2 rounded-2xl bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700"
          >
            Publish Event
          </button>
        </form>
      <% } %>

      <% if ((isOrganizer || isAdmin) && event.status === "published") { %>
        <form
          action="/events/<%= event.id %>/cancel"
          method="post"
          hx-post="/events/<%= event.id %>/cancel"
          hx-target="#event-detail"
          hx-swap="outerHTML"
        >
          <button
            type="submit"
            class="inline-flex items-center px-4 py-2 rounded-2xl bg-rose-600 text-white text-sm font-semibold hover:bg-rose-700"
          >
            Cancel Event
          </button>
        </form>
      <% } %>

      <% if (isOrganizer) { %>
        <a
          href="/events/edit/<%= event.id %>"
          class="inline-flex items-center px-4 py-2 rounded-2xl bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700"
        >
          Edit Event
        </a>
      <% } %>
    </div>
  </footer>
</section>
