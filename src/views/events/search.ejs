<section class="mb-6 p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-indigo-600 to-blue-700 shadow-lg">
  <h1 class="text-2xl sm:text-3xl font-bold text-white mb-1">Search Events</h1>
  <p class="text-blue-200 text-sm sm:text-base m-0">
    Find published upcoming events by title, description, or location.
  </p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section
  class="mb-6 p-5 sm:p-6 border border-slate-200 rounded-2xl bg-white shadow-lg"
  x-data="{ count: <%= query ? query.length : 0 %>, max: 500, loading: false }"
>
  <form
    action="/events/search"
    method="get"
    hx-get="/events/search"
    hx-target="#search-results"
    hx-swap="innerHTML"
    hx-trigger="submit, keyup changed delay:300ms from:input[name='q']"
    hx-indicator="#search-spinner"
    x-on:htmx:before-request.window="loading = true"
    x-on:htmx:after-request.window="loading = false"
    class="flex flex-col"
  >
    <div>
      <label for="q" class="block text-sm font-medium text-slate-700 mb-2">
        Keyword
      </label>
      <div class="relative">
        <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
        <input
          id="q"
          name="q"
          type="search"
          value="<%= query %>"
          maxlength="500"
          placeholder="e.g. hackathon, library, volunteer"
          x-on:input="count = $event.target.value.length"
          class="w-full rounded-xl border border-slate-200 bg-slate-50 pl-10 pr-10 py-3 text-slate-900 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-shadow"
        />
        <button
          type="button"
          x-show="count > 0"
          x-cloak
          x-on:click="count = 0; document.getElementById('q').value = ''; document.getElementById('q').dispatchEvent(new Event('change', { bubbles: true }))"
          class="absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-200 transition-colors cursor-pointer"
          aria-label="Clear search"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex items-center justify-between mt-1.5">
        <p class="text-xs m-0" :class="count >= max ? 'text-red-500 font-medium' : 'text-slate-400'">
          <span x-text="count"></span> / <span x-text="max"></span> characters
        </p>
        <div id="search-spinner" x-show="loading" x-cloak class="inline-flex items-center gap-1.5 text-xs text-blue-600">
          <svg class="h-3.5 w-3.5 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          Searching&hellip;
        </div>
      </div>
    </div>
  </form>
</section>

<section id="search-results" class="mb-6">
  <%- include("partials/search-results", { events: events, query: query }) %>
</section>
