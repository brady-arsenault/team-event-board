<section
  class="max-w-3xl mx-auto px-4 py-8 sm:px-6"
  x-data="{
    dirty: false,
    saved: false,
    descCount: `<%= (event.description || '').length %>` * 1,
    descMax: 500,
    descWarning() { return this.descCount > this.descMax * 0.85 },
    markDirty() { this.dirty = true },
    confirmLeave(e) {
      if (this.dirty && !this.saved) {
        e.preventDefault();
        e.returnValue = '';
      }
    },
    handleSubmit() { this.saved = true }
  }"
  x-init="window.addEventListener('beforeunload', confirmLeave.bind($data))"
>

  <%# ── Card wrapper ── %>
  <div class="rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-100 overflow-hidden">

    <%# ── Header band ── %>
    <div class="bg-gradient-to-r from-blue-600 to-indigo-500 px-6 py-6 sm:px-8">
      <div class="flex items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </span>
          <div>
            <h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Edit Event</h1>
            <p class="mt-0.5 text-xs text-blue-100">Update the event details below.</p>
          </div>
        </div>

        <%# Unsaved-changes badge (Alpine-driven) %>
        <span
          x-show="dirty"
          x-transition:enter="transition ease-out duration-200"
          x-transition:enter-start="opacity-0 scale-95"
          x-transition:enter-end="opacity-100 scale-100"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full bg-amber-400/20 border border-amber-300/40 px-3 py-1 text-xs font-semibold text-amber-100 backdrop-blur-sm"
          aria-live="polite"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-amber-300 animate-pulse"></span>
          Unsaved changes
        </span>
      </div>
    </div>

    <%# ── Unsaved-changes inline banner (visible on mobile too) ── %>
    <div
      x-show="dirty"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-1"
      x-transition:enter-end="opacity-100 translate-y-0"
      class="mx-6 mt-5 sm:mx-8 flex items-center gap-2 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-2.5 text-sm text-amber-800"
      role="alert"
      aria-live="polite"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
      </svg>
      <span>You have unsaved changes. <strong>Save</strong> before leaving or your edits will be lost.</span>
    </div>

    <%# ── Error slot ── %>
    <div id="error-slot" class="px-6 sm:px-8">
      <% if (pageError) { %>
        <div class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%- include("partials/error", { message: pageError }) %>
        </div>
      <% } %>
    </div>

    <%# ── Form ── %>
    <form
      hx-post="/events/edit/<%= event.id %>"
      hx-target="#error-slot"
      hx-swap="innerHTML"
      hx-on::response-error="htmx.swap(htmx.find('#error-slot'), event.detail.xhr.responseText, {swapStyle:'innerHTML'})"
      class="space-y-5 px-6 py-6 sm:px-8 sm:py-7"
      x-on:submit="handleSubmit()"
      x-on:input="markDirty()"
      x-on:change="markDirty()"
    >

      <%# Title %>
      <div>
        <label for="title" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
          Title <span class="text-red-400">*</span>
        </label>
        <input
          id="title"
          name="title"
          type="text"
          required
          value="<%= event.title %>"
          class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                 hover:border-slate-300"
        />
      </div>

      <%# Description + counter %>
      <div>
        <div class="flex items-baseline justify-between mb-1.5">
          <label for="description" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">
            Description <span class="text-red-400">*</span>
          </label>
          <span
            class="text-xs font-medium tabular-nums transition-colors"
            :class="descWarning() ? 'text-amber-600' : 'text-slate-400'"
            x-text="`${descCount} / ${descMax}`"
          ></span>
        </div>
        <textarea
          id="description"
          name="description"
          rows="4"
          required
          :maxlength="descMax"
          x-on:input="descCount = $event.target.value.length"
          class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none resize-none transition
                 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                 hover:border-slate-300"
        ><%= event.description %></textarea>
        <div class="mt-1.5 overflow-hidden rounded-full bg-slate-100 h-1" aria-hidden="true">
          <div
            class="h-full rounded-full transition-all duration-200"
            :class="descWarning() ? 'bg-amber-400' : 'bg-blue-400'"
            :style="`width: ${Math.min((descCount / descMax) * 100, 100)}%`"
          ></div>
        </div>
      </div>

      <%# Location %>
      <div>
        <label for="location" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
          Location <span class="text-red-400">*</span>
        </label>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </span>
          <input
            id="location"
            name="location"
            type="text"
            required
            value="<%= event.location %>"
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                   focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                   hover:border-slate-300"
          />
        </div>
      </div>

      <%# Category + Capacity %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="category" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Category <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <select
              id="category"
              name="category"
              required
              class="w-full appearance-none rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 pr-10 text-sm text-slate-900 outline-none transition
                     focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                     hover:border-slate-300"
            >
              <option value="social"      <%= event.category === "social"      ? "selected" : "" %>>Social</option>
              <option value="educational" <%= event.category === "educational" ? "selected" : "" %>>Educational</option>
              <option value="volunteer"   <%= event.category === "volunteer"   ? "selected" : "" %>>Volunteer</option>
              <option value="sports"      <%= event.category === "sports"      ? "selected" : "" %>>Sports</option>
              <option value="arts"        <%= event.category === "arts"        ? "selected" : "" %>>Arts</option>
              <option value="other"       <%= event.category === "other"       ? "selected" : "" %>>Other</option>
            </select>
            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </div>
        </div>

        <div>
          <label for="capacity" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Capacity
          </label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <input
              id="capacity"
              name="capacity"
              type="number"
              min="1"
              placeholder="No limit"
              value="<%= event.capacity === null ? '' : event.capacity %>"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                     focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                     hover:border-slate-300"
            />
          </div>
        </div>
      </div>

      <%# Dates %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="startAt" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Start date <span class="text-red-400">*</span>
          </label>
          <input
            id="startAt"
            name="startAt"
            type="datetime-local"
            required
            value="<%= event.startAt instanceof Date ? event.startAt.toISOString().slice(0,16) : new Date(event.startAt).toISOString().slice(0,16) %>"
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition
                   focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                   hover:border-slate-300"
          />
        </div>

        <div>
          <label for="endAt" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            End date <span class="text-red-400">*</span>
          </label>
          <input
            id="endAt"
            name="endAt"
            type="datetime-local"
            required
            value="<%= event.endAt instanceof Date ? event.endAt.toISOString().slice(0,16) : new Date(event.endAt).toISOString().slice(0,16) %>"
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition
                   focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10
                   hover:border-slate-300"
          />
        </div>
      </div>

      <%# Divider %>
      <hr class="border-slate-100" />

      <%# Footer actions %>
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-end sm:gap-3">
        <button
          type="button"
          x-on:click="saved = true; history.back()"
          class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 shadow-sm transition
                hover:bg-slate-50 hover:border-slate-300 active:scale-95"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition
                 hover:bg-blue-700 active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Save Changes
        </button>
      </div>

    </form>
  </div>
</section>
