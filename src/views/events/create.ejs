<section
  class="max-w-3xl mx-auto px-4 py-8 sm:px-6"
  x-data="{
    descCount: 0,
    descMax: 500,
    descWarning() { return this.descCount > this.descMax * 0.85 }
  }"
>

  <%# ── Card wrapper ── %>
  <div class="rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-100 overflow-hidden">

    <%# ── Header band ── %>
    <div class="bg-gradient-to-r from-emerald-600 to-teal-500 px-6 py-6 sm:px-8">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/20 backdrop-blur-sm">
          <%# calendar icon %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
        </span>
        <div>
          <h1 class="text-xl font-bold tracking-tight text-white sm:text-2xl">Create Event</h1>
          <p class="mt-0.5 text-xs text-emerald-100">Fill in the details below to create your event.</p>
        </div>
      </div>
    </div>

    <%# ── Error slot ── %>
    <div id="error-slot" class="px-6 sm:px-8">
      <% if (pageError) { %>
        <div class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%- include("partials/error", { message: pageError }) %>
        </div>
      <% } %>
    </div>

    <%# ── Form ── %>
    <form
      hx-post="/events/create"
      hx-target="#error-slot"
      hx-swap="innerHTML"
      hx-on::response-error="htmx.swap(htmx.find('#error-slot'), event.detail.xhr.responseText, {swapStyle:'innerHTML'})"
      class="space-y-5 px-6 py-6 sm:px-8 sm:py-7"
    >

      <%# Title %>
      <div class="group">
        <label for="title" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
          Title <span class="text-red-400">*</span>
        </label>
        <input
          id="title"
          name="title"
          type="text"
          required
          placeholder="Give your event a memorable name"
          class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                 hover:border-slate-300"
        />
      </div>

      <%# Description + Alpine counter %>
      <div>
        <div class="flex items-baseline justify-between mb-1.5">
          <label for="description" class="block text-xs font-semibold uppercase tracking-wide text-slate-500">
            Description <span class="text-red-400">*</span>
          </label>
          <span
            class="text-xs font-medium tabular-nums transition-colors"
            :class="descWarning() ? 'text-amber-600' : 'text-slate-400'"
            x-text="`${descCount} / ${descMax}`"
          ></span>
        </div>
        <textarea
          id="description"
          name="description"
          rows="4"
          required
          :maxlength="descMax"
          x-on:input="descCount = $event.target.value.length"
          placeholder="What's the event about? Include any important details…"
          class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none resize-none transition
                 focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                 hover:border-slate-300"
        ></textarea>
        <div
          class="mt-1.5 overflow-hidden rounded-full bg-slate-100 h-1"
          title="Character usage"
          aria-hidden="true"
        >
          <div
            class="h-full rounded-full transition-all duration-200"
            :class="descWarning() ? 'bg-amber-400' : 'bg-emerald-400'"
            :style="`width: ${Math.min((descCount / descMax) * 100, 100)}%`"
          ></div>
        </div>
      </div>

      <%# Location %>
      <div>
        <label for="location" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
          Location <span class="text-red-400">*</span>
        </label>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </span>
          <input
            id="location"
            name="location"
            type="text"
            required
            placeholder="Address or venue name"
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                   focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                   hover:border-slate-300"
          />
        </div>
      </div>

      <%# Category + Capacity %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="category" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Category <span class="text-red-400">*</span>
          </label>
          <div class="relative">
            <select
              id="category"
              name="category"
              required
              class="w-full appearance-none rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 pr-10 text-sm text-slate-900 outline-none transition
                     focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                     hover:border-slate-300"
            >
              <option value="social">Social</option>
              <option value="educational">Educational</option>
              <option value="volunteer">Volunteer</option>
              <option value="sports">Sports</option>
              <option value="arts">Arts</option>
              <option value="other">Other</option>
            </select>
            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </div>
        </div>

        <div>
          <label for="capacity" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Capacity
          </label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <input
              id="capacity"
              name="capacity"
              type="number"
              min="1"
              placeholder="No limit"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 pl-10 pr-4 py-3 text-sm text-slate-900 placeholder:text-slate-400 outline-none transition
                     focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                     hover:border-slate-300"
            />
          </div>
        </div>
      </div>

      <%# Dates %>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="startAt" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            Start date <span class="text-red-400">*</span>
          </label>
          <input
            id="startAt"
            name="startAt"
            type="datetime-local"
            required
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition
                   focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                   hover:border-slate-300"
          />
        </div>

        <div>
          <label for="endAt" class="block text-xs font-semibold uppercase tracking-wide text-slate-500 mb-1.5">
            End date <span class="text-red-400">*</span>
          </label>
          <input
            id="endAt"
            name="endAt"
            type="datetime-local"
            required
            class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-900 outline-none transition
                   focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-500/10
                   hover:border-slate-300"
          />
        </div>
      </div>

      <%# Divider %>
      <hr class="border-slate-100" />

      <%# Footer: draft note + actions %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="flex items-start gap-1.5 text-xs text-slate-500 leading-relaxed max-w-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          Drafts are private until published. Manage them in
          <a href="/events/drafts" class="ml-0.5 font-semibold text-emerald-700 underline underline-offset-2 hover:text-emerald-800">My Drafts</a>.
        </p>

        <div class="flex flex-col gap-2 sm:flex-row sm:gap-3">
          <button
            type="submit"
            name="action"
            value="draft"
            class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition
                   hover:bg-slate-50 hover:border-slate-300 active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
            </svg>
            Save as Draft
          </button>
          <button
            type="submit"
            name="action"
            value="publish"
            class="inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition
                   hover:bg-emerald-700 active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            Publish Now
          </button>
        </div>
      </div>

    </form>
  </div>
</section>
